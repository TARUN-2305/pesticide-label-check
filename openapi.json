     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorOut"
        }
       }
      },
      "description": "Unprocessable Entity"
     },
     "429": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorOut"
        }
       }
      },
      "description": "Too Many Requests"
     }
    },
    "summary": "Lookup"
   }
  },
  "/v1/pests": {
   "get": {
    "operationId": "pests_v1_pests_get",
    "parameters": [
     {
      "in": "query",
      "name": "q",
      "required": true,
      "schema": {
       "maxLength": 80,
       "minLength": 1,
       "title": "Q",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "crop",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 80,
         "type": "string"
        },
        {
         "type": "null"
